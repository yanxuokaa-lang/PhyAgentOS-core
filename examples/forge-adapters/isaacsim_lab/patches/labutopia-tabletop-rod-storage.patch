+def _place_rod_in_rack(stage: Usd.Stage, rod: Usd.Prim, source_points: np.ndarray, rack: Usd.Prim,
+                       rack_center_xy: list[float], slot: dict[str, Any]) -> None:
+    """Author a storage pose from the source axis and the rack support surface."""
+    points = np.unique(source_points.reshape(-1, 3), axis=0)
+    center = (points.min(axis=0) + points.max(axis=0)) * 0.5
+    _, axes = np.linalg.eigh(np.cov(points.T))
+    axis = axes[:, -1]
+    if axis[2] < 0:
+        axis = -axis
+    rotation = Gf.Rotation(Gf.Vec3d(*axis), Gf.Vec3d(0, 0, 1))
+    matrix = Gf.Matrix4d().SetRotate(rotation)
+    rotated = np.array([matrix.Transform(Gf.Vec3d(*point)) for point in points - center])
+    support = stage.GetPrimAtPath(rack.GetPath().AppendPath('Model/' + slot['bottom_plate']))
+    if not support or not support.HasAPI(UsdPhysics.CollisionAPI):
+        raise RuntimeError('Rod storage requires an existing rack support collider')
+    _, support_high = _world_bounds(stage, support)
+    xy = np.asarray(rack_center_xy) + np.asarray(slot['center_offset_xy'])
+    clearance = float(slot['support_clearance_m'])
+    if not np.isfinite(clearance) or not 0 <= clearance <= .001:
+        raise ValueError('Rod support clearance must lie between zero and one millimeter')
+    target_center = Gf.Vec3d(*xy, support_high[2] - rotated[:, 2].min() + clearance)
+    xform = UsdGeom.Xformable(rod)
+    xform.ClearXformOpOrder()
+    xform.AddTranslateOp().Set(target_center - matrix.Transform(Gf.Vec3d(*center)))
+    xform.AddOrientOp(UsdGeom.XformOp.PrecisionDouble).Set(rotation.GetQuat())
+    rod.CreateRelationship('lab:storage_support', custom=True).SetTargets([support.GetPath()])
+    rod.CreateAttribute('lab:storage_slot_center_xy', Sdf.ValueTypeNames.Double2, custom=True).Set(Gf.Vec2d(*xy))
+
+
+def _inspect_rod_storage(stage: Usd.Stage, config: dict[str, Any]) -> dict[str, Any]:
+    """Measure the actual placed rod against the existing rack plates."""
+    rod = stage.GetPrimAtPath('/World/OperationArea/GlassRod')
+    low, high = _world_bounds(stage, stage.GetPrimAtPath(rod.GetPath().AppendChild('Model')))
+    center = np.array((low + high) * .5)
+    radius = max(float(high[0] - low[0]), float(high[1] - low[1])) * .5
+    slot = config['layout']['glass_rod']['rack_slot']
+    support_path = '/World/TubeRack/Model/' + slot['bottom_plate']
+    support = stage.GetPrimAtPath(support_path)
+    support_low, support_high = _world_bounds(stage, support)
+    gap = float(low[2] - support_high[2])
+    if rod.GetRelationship('lab:storage_support').GetTargets() != [support.GetPath()]:
+        raise RuntimeError('Rod storage support does not match its configured rack plate')
+    if not -.0001 <= gap <= .001:
+        raise RuntimeError(f'Rod does not rest on the rack bottom plate: gap={gap:.6f} m')
+    if any(low[i] < support_low[i] or high[i] > support_high[i] for i in (0, 1)):
+        raise RuntimeError('Rod extends beyond its rack support')
+    if max(high[0] - low[0], high[1] - low[1]) > .02:
+        raise RuntimeError('Stored rod is not upright')
+    clearances = {}
+    for suffix in slot['guide_plates']:
+        plate = stage.GetPrimAtPath('/World/TubeRack/Model/' + suffix)
+        plate_low, plate_high = _world_bounds(stage, plate)
+        if low[2] >= plate_low[2] or high[2] <= plate_high[2]:
+            raise RuntimeError('Stored rod must pass through both rack guide plates')
+        segments = _cross_section_segments(_world_triangles(stage, plate), (plate_low[2]+plate_high[2])*.5)
+        # An even number of ray crossings places the center in empty space;
+        # support bounds and edge clearance then distinguish a rack hole.
+        a, b = segments[:, 0], segments[:, 1]
+        crossing = (a[:, 1] > center[1]) != (b[:, 1] > center[1])
+        start, end = a[crossing], b[crossing]
+        hits_x = start[:, 0] + (center[1] - start[:, 1]) * (end[:, 0] - start[:, 0]) / (end[:, 1] - start[:, 1])
+        if np.count_nonzero(hits_x > center[0]) % 2:
+            raise RuntimeError(f'Rod center lies inside a solid rack guide plate: {plate.GetPath()}')
+        edge = segments[:, 1] - segments[:, 0]
+        fraction = np.clip(np.sum((center[:2] - segments[:, 0])*edge, axis=1) / np.sum(edge*edge, axis=1), 0., 1.)
+        clearance = float(np.linalg.norm(segments[:, 0]+fraction[:, None]*edge-center[:2], axis=1).min()-radius)
+        if clearance <= 0:
+            raise RuntimeError(f'Rod intersects a rack guide plate: {plate.GetPath()}')
+        clearances[str(plate.GetPath())] = round(clearance, 6)
+    for prim in Usd.PrimRange(stage.GetPrimAtPath('/World/TubeRack')):
+        if prim.GetAttribute('lab:asset_type').Get() == 'test_tube':
+            tube_low, tube_high = _world_bounds(stage, prim)
+            if all(low[i] < tube_high[i] and high[i] > tube_low[i] for i in (0, 1, 2)):
+                raise RuntimeError(f'Rod storage overlaps an occupied tube: {prim.GetPath()}')
+    return {'support_path': support_path, 'center_xy_m': center[:2].tolist(),
+            'bottom_z_m': float(low[2]), 'top_z_m': float(high[2]), 'support_gap_m': round(gap, 6),
+            'guide_plate_clearance_m': clearances, 'scope': 'static USD geometry; no grasp or motion qualification'}


